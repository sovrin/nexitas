{
  "name": "nexitas",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "main": "./nuxt.config.ts",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx scripts/dev.ts nexitas",
    "build": "nuxt build",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "owner:reset": "node --env-file-if-exists=.env --import tsx scripts/reset-owner.ts nexitas",
    "format": "oxfmt -c oxfmt.config.ts .",
    "format:check": "oxfmt -c oxfmt.config.ts --check .",
    "lint": "oxlint -c oxlint.config.ts && node scripts/drift.ts",
    "lint:fix": "oxlint -c oxlint.config.ts --fix",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "nuxt": "4.5.2",
    "vue": "3.5.42",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.11"
  }
}
