# Generate once: openssl rand -hex 32. It protects creating the owner account on first start.
NEXITAS_BOOTSTRAP_TOKEN=

# The address people open nexitas at; it only accepts changes from here.
# NEXITAS_ORIGIN=http://localhost:3000

# Where the web service listens on the host (loopback by default; your proxy reaches it there or
# over a network added in compose.override.yaml).
# NEXITAS_BIND=127.0.0.1:3000

# collatas: gets a JSON POST for every new feedback (see collatas' README, "Webhook").
# COLLATAS_WEBHOOK_URL=https://ntfy.example.com/collatas?tpl=yes&t=...&m=...
